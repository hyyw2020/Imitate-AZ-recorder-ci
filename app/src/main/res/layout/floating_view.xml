<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@color/floating_bg"
    android:padding="8dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/ivIndicator"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:src="@drawable/ic_indicator"
        android:layout_marginEnd="8dp" />

    <TextView
        android:id="@+id/tvDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:textSize="12sp"
        android:textColor="@color/floating_text"
        android:minWidth="48dp"
        android:gravity="center"
        android:layout_marginEnd="4dp" />

    <Button
        android:id="@+id/btnPause"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:minWidth="64dp"
        android:text="@string/btn_pause"
        android:textSize="12sp"
        android:textColor="@color/floating_text"
        android:backgroundTint="@color/floating_btn_pause"
        android:layout_marginEnd="4dp" />

    <Button
        android:id="@+id/btnStop"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:minWidth="64dp"
        android:text="@string/btn_stop"
        android:textSize="12sp"
        android:textColor="@color/floating_text"
        android:backgroundTint="@color/floating_btn_stop" />

</LinearLayout>
